{
  "extends": ["next/core-web-vitals", "plugin:jsx-a11y/recommended"],
  "plugins": ["jsx-a11y"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/features/**"],
            "message": "Não é permitido importar de \"@/features\"."
          }
        ]
      }
    ],
    "import/no-cycle": "error"
  }
}
